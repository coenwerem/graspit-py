diff --git a/CMakeMacros/FindSoQt.cmake b/CMakeMacros/FindSoQt.cmake
new file mode 100644
index 0000000..c522605
--- /dev/null
+++ b/CMakeMacros/FindSoQt.cmake
@@ -0,0 +1,59 @@
+# Compatibility Find module for SoQt.
+#
+# GraspIt!'s build calls `find_package(SoQt REQUIRED)`, but this repo ships a
+# legacy finder named `FindSoQt4.cmake`. Many systems also provide a modern
+# `SoQtConfig.cmake` (CONFIG package).
+#
+# This module bridges both worlds by:
+#  1) Trying CONFIG-mode first (preferred when available)
+#  2) Falling back to the legacy `FindSoQt4.cmake`
+#
+# It also populates the legacy variables used by GraspIt!:
+#   SOQT_INCLUDE_DIRS, SOQT_LIBRARY, SOQT_LINK_DIRS, SOQT_CXXFLAGS
+
+# Prefer a package config if the system provides one.
+find_package(SoQt CONFIG QUIET)
+
+if(SoQt_FOUND)
+  # Populate legacy variables when possible.
+  if(TARGET SoQt::SoQt)
+    set(SOQT_LIBRARY SoQt::SoQt)
+    get_target_property(_soqt_inc SoQt::SoQt INTERFACE_INCLUDE_DIRECTORIES)
+    if(_soqt_inc)
+      set(SOQT_INCLUDE_DIRS ${_soqt_inc})
+    endif()
+  elseif(DEFINED SoQt_LIBRARIES)
+    set(SOQT_LIBRARY ${SoQt_LIBRARIES})
+  endif()
+
+  if(DEFINED SoQt_INCLUDE_DIRS AND NOT DEFINED SOQT_INCLUDE_DIRS)
+    set(SOQT_INCLUDE_DIRS ${SoQt_INCLUDE_DIRS})
+  endif()
+
+  if(NOT DEFINED SOQT_LINK_DIRS)
+    set(SOQT_LINK_DIRS "")
+  endif()
+  if(NOT DEFINED SOQT_CXXFLAGS)
+    set(SOQT_CXXFLAGS "")
+  endif()
+
+  set(SOQT_LIBRARY_FOUND 1)
+  return()
+endif()
+
+# Fall back to the legacy module shipped with this repo.
+include(${CMAKE_CURRENT_LIST_DIR}/FindSoQt4.cmake)
+
+# Standardize the result variable for `find_package(SoQt ...)`.
+include(FindPackageHandleStandardArgs)
+
+# FindSoQt4 sets SOQT_LIBRARY_FOUND and fills SOQT_* variables.
+# We treat SOQT_LIBRARY and SOQT_INCLUDE_DIRS as the authoritative REQUIRED vars.
+find_package_handle_standard_args(
+  SoQt
+  REQUIRED_VARS SOQT_LIBRARY SOQT_INCLUDE_DIRS
+)
+
+if(SoQt_FOUND)
+  set(SOQT_LIBRARY_FOUND 1)
+endif()
