+/*! Imports a robot from a URDF file. This function parses the URDF XML structure
+    and converts it to GraspIt robot format on-the-fly.
+*/
+Robot *
+World::importRobotFromURDF(QString filename, const TiXmlElement *root)
+{
+  QString robotName = root->Attribute("name");
+  if (robotName.isNull()) {
+    QTWARNING("URDF robot name not found");
+    return NULL;
+  }
+
+  QTWARNING("Loading URDF robot: " + robotName + " from " + filename);
+
+  // Create a Hand robot (most URDF robots are hands/grippers)
+  Robot *robot = (Robot *) getWorldElementFactory().createElement("Hand", this, NULL);
+  if (!robot) {
+    QTWARNING("Unable to create Hand robot for URDF import");
+    return NULL;
+  }
+
+  QString rootPath = filename.section('/', 0, -2, QString::SectionIncludeTrailingSep);
+  robot->setName(robotName);
+  QString myFilename = relativePath(filename, getenv("GRASPIT"));
+  robot->setFilename(myFilename);
+
+  if (!QFile::exists(rootPath + "placeholder_palm.xml")) {
+    const char *graspitRoot = getenv("GRASPIT");
+    if (graspitRoot) {
+      QString candidate = QString::fromLatin1(graspitRoot);
+      if (!candidate.endsWith("/")) {
+        candidate += "/";
+      }
+      candidate += "models/robots/realhand/";
+      if (QFile::exists(candidate + "placeholder_palm.xml")) {
+        rootPath = candidate;
+      }
+    }
+  }
+
+  // Parse URDF and convert to GraspIt format
+  if (loadRobotFromURDF(robot, root, rootPath) == FAILURE) {
+    QTWARNING("Failed to load URDF robot from file");
+    delete robot;
+    return NULL;
+  }
+
+  addRobot(robot);
+  return robot;
+}
+
+/*! Loads robot data from a URDF XML structure and converts it to GraspIt format.
+    This is a complex conversion that parses URDF links and joints.
+*/
+int
+World::loadRobotFromURDF(Robot *robot, const TiXmlElement *root, QString rootPath)
+{
+  // Parse URDF robot name
+  QString robotName = root->Attribute("name");
+  if (robotName.isNull()) {
+    QTWARNING("URDF robot name not found");
+    return FAILURE;
+  }
+
+  // Find all links and joints
+  std::map<QString, const TiXmlElement*> links;
+  std::map<QString, const TiXmlElement*> joints;
+
+  const TiXmlElement *child = root->FirstChildElement();
+  while (child) {
+    QString elementName = child->Value();
+    if (elementName == "link") {
+      QString linkName = child->Attribute("name");
+      if (!linkName.isNull()) {
+        links[linkName] = child;
+      }
+    } else if (elementName == "joint") {
+      QString jointName = child->Attribute("name");
+      if (!jointName.isNull()) {
+        joints[jointName] = child;
+      }
+    }
+    child = child->NextSiblingElement();
+  }
+
+  // Find the base link (link with no parent joint)
+  QString baseLinkName;
+  std::set<QString> childLinks;
+  for (auto& jointPair : joints) {
+    const TiXmlElement *joint = jointPair.second;
+    const TiXmlElement *childElement = findXmlElement(joint, "child");
+    if (childElement) {
+      QString childLink = childElement->Attribute("link");
+      if (!childLink.isNull()) {
+        childLinks.insert(childLink);
+      }
+    }
+  }
+
+  for (auto& linkPair : links) {
+    if (childLinks.find(linkPair.first) == childLinks.end()) {
+      baseLinkName = linkPair.first;
+      break;
+    }
+  }
+
+  if (baseLinkName.isNull()) {
+    QTWARNING("Could not find base link in URDF");
+    return FAILURE;
+  }
+
+  QTWARNING("Found base link: " + baseLinkName);
+
+  // Create GraspIt XML structure from URDF
+  TiXmlElement graspitRoot("robot");
+  graspitRoot.SetAttribute("type", "Hand");
+  graspitRoot.SetAttribute("DBName", robotName.toStdString());
+
+  // Add palm (base link)
+  TiXmlElement palmElement("palm");
+  palmElement.SetAttribute("sensorType", "TactileSensor");
+  // Use placeholder for now - full mesh conversion would require URDF mesh processing
+  palmElement.InsertEndChild(TiXmlText("../placeholder_palm.xml"));
+  graspitRoot.InsertEndChild(palmElement);
+
+  // Process joints to create DOFs and chains
+  int dofIndex = 0;
+  std::map<QString, int> jointToDofMap;
+
+  // First pass: create DOFs for all joints
+  for (auto& jointPair : joints) {
+    const TiXmlElement *joint = jointPair.second;
+    QString jointType = joint->Attribute("type");
+
+    if (jointType == "revolute" || jointType == "prismatic") {
+      TiXmlElement dofElement("dof");
+      dofElement.SetAttribute("type", jointType == "revolute" ? "r" : "p");
+
+      const TiXmlElement *limitElement = findXmlElement(joint, "limit");
+      if (limitElement) {
+        const char *lower = limitElement->Attribute("lower");
+        const char *upper = limitElement->Attribute("upper");
+        if (lower && upper) {
+          TiXmlElement minValElement("minValue");
+          minValElement.InsertEndChild(TiXmlText(lower));
+          dofElement.InsertEndChild(minValElement);
+
+          TiXmlElement maxValElement("maxValue");
+          maxValElement.InsertEndChild(TiXmlText(upper));
+          dofElement.InsertEndChild(maxValElement);
+        }
+      }
+
+      // Default values
+      TiXmlElement velElement("defaultVelocity");
+      velElement.InsertEndChild(TiXmlText("1.0"));
+      dofElement.InsertEndChild(velElement);
+
+      TiXmlElement effortElement("maxEffort");
+      effortElement.InsertEndChild(TiXmlText("5.0e+10"));
+      dofElement.InsertEndChild(effortElement);
+
+      TiXmlElement kpElement("Kp");
+      kpElement.InsertEndChild(TiXmlText("1.0e+11"));
+      dofElement.InsertEndChild(kpElement);
+
+      TiXmlElement kdElement("Kd");
+      kdElement.InsertEndChild(TiXmlText("1.0e+7"));
+      dofElement.InsertEndChild(kdElement);
+
+      TiXmlElement scaleElement("draggerScale");
+      scaleElement.InsertEndChild(TiXmlText("20"));
+      dofElement.InsertEndChild(scaleElement);
+
+      graspitRoot.InsertEndChild(dofElement);
+      jointToDofMap[jointPair.first] = dofIndex++;
+    }
+  }
+
+  // Second pass: create kinematic chains
+  // For simplicity, create one chain per finger (simplified approach)
+  std::map<QString, std::vector<const TiXmlElement*>> chains;
+
+  for (auto& jointPair : joints) {
+    const TiXmlElement *joint = jointPair.second;
+    const TiXmlElement *childElement = findXmlElement(joint, "child");
+
+    if (childElement) {
+      QString childLink = childElement->Attribute("link");
+      QString parentLink;
+
+      const TiXmlElement *parentElement = findXmlElement(joint, "parent");
+      if (parentElement) {
+        parentLink = parentElement->Attribute("link");
+      }
+
+      // Simple chain building: group joints by their child link hierarchy
+      if (!parentLink.isNull() && parentLink != baseLinkName) {
+        // This is a continuing chain
+        for (auto& chain : chains) {
+          if (!chain.second.empty()) {
+            const TiXmlElement *lastJoint = chain.second.back();
+            const TiXmlElement *lastChild = findXmlElement(lastJoint, "child");
+            if (lastChild && QString(lastChild->Attribute("link")) == parentLink) {
+              chain.second.push_back(joint);
+              break;
+            }
+          }
+        }
+      } else {
+        // Start a new chain
+        chains[childLink].push_back(joint);
+      }
+    }
+  }
+
+  // Create chain elements in GraspIt format
+  for (auto& chain : chains) {
+    TiXmlElement chainElement("chain");
+
+    // Add transform (simplified - would need proper DH parameter conversion)
+    TiXmlElement transformElement("transform");
+    TiXmlElement translationElement("translation");
+    translationElement.InsertEndChild(TiXmlText("0 0 0"));
+    transformElement.InsertEndChild(translationElement);
+    TiXmlElement rotationElement("rotation");
+    rotationElement.InsertEndChild(TiXmlText("0 z"));
+    transformElement.InsertEndChild(rotationElement);
+    chainElement.InsertEndChild(transformElement);
+
+    // Add joints in the chain
+    for (const TiXmlElement *joint : chain.second) {
+      TiXmlElement jointElement("joint");
+
+      QString jointType = joint->Attribute("type");
+
+      if (jointType == "revolute") {
+        jointElement.SetAttribute("type", "Revolute");
+
+        // Add DH parameters (simplified)
+        TiXmlElement thetaElement("theta");
+        auto dofIt = jointToDofMap.find(joint->Attribute("name"));
+        if (dofIt != jointToDofMap.end()) {
+          QString thetaVal = QString("d%1").arg(dofIt->second);
+          thetaElement.InsertEndChild(TiXmlText(thetaVal.toStdString()));
+        } else {
+          thetaElement.InsertEndChild(TiXmlText("0"));
+        }
+        jointElement.InsertEndChild(thetaElement);
+
+        TiXmlElement dElement("d");
+        dElement.InsertEndChild(TiXmlText("0"));
+        jointElement.InsertEndChild(dElement);
+
+        TiXmlElement aElement("a");
+        aElement.InsertEndChild(TiXmlText("0"));
+        jointElement.InsertEndChild(aElement);
+
+        TiXmlElement alphaElement("alpha");
+        alphaElement.InsertEndChild(TiXmlText("0"));
+        jointElement.InsertEndChild(alphaElement);
+
+        // Add limits
+        const TiXmlElement *limitElement = findXmlElement(joint, "limit");
+        if (limitElement) {
+          const char *lower = limitElement->Attribute("lower");
+          const char *upper = limitElement->Attribute("upper");
+          if (lower) {
+            TiXmlElement minValElement("minValue");
+            minValElement.InsertEndChild(TiXmlText(lower));
+            jointElement.InsertEndChild(minValElement);
+          }
+          if (upper) {
+            TiXmlElement maxValElement("maxValue");
+            maxValElement.InsertEndChild(TiXmlText(upper));
+            jointElement.InsertEndChild(maxValElement);
+          }
+        }
+
+        TiXmlElement frictionElement("viscousFriction");
+        frictionElement.InsertEndChild(TiXmlText("5.0e+7"));
+        jointElement.InsertEndChild(frictionElement);
+
+      } else if (jointType == "prismatic") {
+        jointElement.SetAttribute("type", "Prismatic");
+        // Similar setup for prismatic joints...
+      }
+
+      chainElement.InsertEndChild(jointElement);
+    }
+
+    // Add link elements (placeholder)
+    for (size_t i = 0; i < chain.second.size(); i++) {
+      TiXmlElement linkElement("link");
+      linkElement.SetAttribute("dynamicJointType", "Revolute");
+      linkElement.InsertEndChild(TiXmlText("../placeholder_link.xml"));
+      chainElement.InsertEndChild(linkElement);
+    }
+
+    graspitRoot.InsertEndChild(chainElement);
+  }
+
+  // Load using existing GraspIt XML loading
+  return robot->loadFromXml(&graspitRoot, rootPath);
+}
