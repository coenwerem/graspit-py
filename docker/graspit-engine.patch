+/*! Performs one dynamics step without rescheduling any idle sensor.
+
+Returns the dynamics engine return code (typically 0 on success; -1 on error).
+*/
+int
+World::stepDynamicsManual()
+{
+  int ret = mDynamicsEngine->stepDynamics();
+
+#ifdef BULLET_DYNAMICS
+  // GraspitDynamics updates worldTime internally, but BulletDynamics does not.
+  // When driving dynamics manually (no idle sensor), we advance worldTime here
+  // to keep the Python-visible clock consistent.
+  if (ret != -1) {
+    worldTime += dynamicsTimeStep;
+  }
+#endif
+
+  return ret;
+}
